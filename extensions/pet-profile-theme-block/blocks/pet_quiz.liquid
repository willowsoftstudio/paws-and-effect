{% comment %}
  Paws & Effect Storefront Pet Profile Quiz App Block
  This renders as a customizable, responsive, drag-and-drop block inside the merchant's Theme Editor.
{% endcomment %}

<div class="paws-effect-storefront-section" style="margin: 30px 0; text-align: center;">
  <button id="paws-effect-quiz-trigger" style="padding: 14px 28px; background-color: #008060; color: #fff; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 16px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: transform 0.2s;">
    🐾 Personalize My Pet's Subscription
  </button>
</div>

<!-- Modal Quiz Dialog (Hidden by Default) -->
<div id="paws-effect-quiz-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 99999; align-items: center; justify-content: center;">
  <div style="background-color: #fff; padding: 24px; border-radius: 12px; width: 100%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); position: relative; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <button id="paws-effect-modal-close" style="position: absolute; top: 16px; right: 16px; background: none; border: none; font-size: 20px; cursor: pointer; color: #6d7175;">✕</button>
    
    <h2 style="margin-top: 0; margin-bottom: 8px; font-size: 20px; color: #008060;">Paws & Effect Pet Quiz 🐾</h2>
    <p style="margin: 0 0 20px 0; font-size: 13px; color: #6d7175;">Tell us about your pet, and we'll dynamically customize their subscriptions and filter out any food allergens!</p>

    <form id="paws-effect-quiz-form" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
      <input type="text" id="paws-pet-name" placeholder="Pet Name (e.g. Max)" required style="padding: 8px; border-radius: 4px; border: 1px solid #c9cccf; font-size: 14px;">
      <select id="paws-pet-type" style="padding: 8px; border-radius: 4px; border: 1px solid #c9cccf; font-size: 14px;">
        <option value="dog">Dog</option>
        <option value="cat">Cat</option>
        <option value="bird">Bird</option>
        <option value="other">Other</option>
      </select>
      <input type="text" id="paws-pet-breed" placeholder="Breed (e.g. Golden Retriever)" style="padding: 8px; border-radius: 4px; border: 1px solid #c9cccf; font-size: 14px;">
      <input type="text" id="paws-pet-age" placeholder="Age (Years)" style="padding: 8px; border-radius: 4px; border: 1px solid #c9cccf; font-size: 14px;">
      <input type="text" id="paws-pet-weight" placeholder="Weight (kg)" style="padding: 8px; border-radius: 4px; border: 1px solid #c9cccf; font-size: 14px;">
      <select id="paws-pet-activity" style="padding: 8px; border-radius: 4px; border: 1px solid #c9cccf; font-size: 14px;">
        <option value="lazy">Lazy / Inactive</option>
        <option value="moderate" selected>Moderately Active</option>
        <option value="active">Highly Active</option>
      </select>
      <input type="text" id="paws-pet-allergies" placeholder="Allergies (comma separated, e.g. beef, chicken)" style="padding: 8px; border-radius: 4px; border: 1px solid #c9cccf; font-size: 14px; grid-column: span 2;">
      <input type="text" id="paws-pet-health" placeholder="Health Issues (comma separated, e.g. joint, sensitive stomach)" style="padding: 8px; border-radius: 4px; border: 1px solid #c9cccf; font-size: 14px; grid-column: span 2;">
      
      <button type="submit" style="grid-column: span 2; padding: 12px; background-color: #008060; color: #fff; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 15px; margin-top: 8px;">
        🐾 Generate My Personalized Nutrition Plan
      </button>
    </form>
  </div>
</div>

<script>
  (function() {
    const trigger = document.getElementById("paws-effect-quiz-trigger");
    const modal = document.getElementById("paws-effect-quiz-modal");
    const closeBtn = document.getElementById("paws-effect-modal-close");
    const form = document.getElementById("paws-effect-quiz-form");

    // Open Modal
    if (trigger) {
      trigger.addEventListener("click", () => {
        modal.style.display = "flex";
      });
    }

    // Close Modal
    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        modal.style.display = "none";
      });
    }

    // Form Submit Handler
    if (form) {
      form.addEventListener("submit", (ev) => {
        ev.preventDefault();

        // Safe regex formatting as they submit (Real-time formatting backend sync)
        const rawAge = document.getElementById("paws-pet-age").value.replace(/[^0-9]/g, "");
        const rawWeight = document.getElementById("paws-pet-weight").value.replace(/[^0-9.]/g, "").replace(/(\..*?)\..*/g, "$1");

        const payload = {
          customerId: "gid://shopify/Customer/123", // Static fallback or read from native liquid {{ customer.id }} if logged in!
          name: document.getElementById("paws-pet-name").value,
          petType: document.getElementById("paws-pet-type").value,
          breed: document.getElementById("paws-pet-breed").value,
          age: rawAge,
          weight: rawWeight,
          activityLevel: document.getElementById("paws-pet-activity").value,
          allergies: document.getElementById("paws-pet-allergies").value.split(",").map(s => s.trim()).filter(s => s !== ""),
          healthIssues: document.getElementById("paws-pet-health").value.split(",").map(s => s.trim()).filter(s => s !== "")
        };

        // Dispatch directly to your Vercel development preview API backend!
        fetch("https://paws-and-effect-git-develop-willowsoftstudio-5437s-projects.vercel.app/api/pets/profile", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "x-test-session-id": "paws-portal-session",
            "x-shop-domain": "celestial-drift-5uuwyo06.myshopify.com"
          },
          body: JSON.stringify(payload)
        })
          .then(res => {
            if (res.status === 403) {
              return res.json().then(err => { alert("🔒 Plan Limit: " + err.message); });
            }
            return res.json().then(data => {
              if (data.success) {
                alert("🐾 Pet Profile for " + payload.name + " created successfully! Your personalized nutrition plan has been generated.");
                modal.style.display = "none";
                form.reset();
              }
            });
          })
          .catch(err => {
            alert("❌ Connection Error: Failed to reach Paws & Effect servers. Please try again later.");
          });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Pet Profile Quiz",
  "target": "section",
  "templates": ["index", "product", "cart"],
  "settings": []
}
{% endschema %}
