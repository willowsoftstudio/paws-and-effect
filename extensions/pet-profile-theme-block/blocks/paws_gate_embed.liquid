            }
          })
          .catch(err => {
            console.error("❌ Paws & Effect API Connection Error:", err);
            alert("❌ Connection Error: Failed to save pet profile.");
          });
      });
      }
      })();

  // --- Storefront Cart & Drawer Url-to-Clickable-Link Converter ---
  function convertPrescriptionUrlsToLinks() {
    const walk = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
    const textNodes = [];
    let node;
    while (node = walk.nextNode()) {
      if (node.nodeValue && node.nodeValue.includes("/api/vets/view-prescription")) {
        textNodes.push(node);
      }
    }

    textNodes.forEach(node => {
      const parent = node.parentNode;
      if (!parent || parent.tagName === "A" || parent.tagName === "SCRIPT" || parent.tagName === "STYLE" || parent.tagName === "TEXTAREA" || parent.tagName === "INPUT") return;

      const originalText = node.nodeValue;
      const urlRegex = /((?:https?:\/\/[^\s"']*)?\/api\/vets\/view-prescription[^\s"']*)/g;
      if (urlRegex.test(originalText)) {
        const tempSpan = document.createElement("span");
        tempSpan.innerHTML = originalText.replace(urlRegex, (url) => {
          return `<a href="${url}" target="_blank" style="color: #008060; text-decoration: underline; font-weight: bold;">View Prescription ⚕️</a>`;
        });
        parent.replaceChild(tempSpan, node);
      }
    });
  }

       if (document.readyState === "loading") {
       document.addEventListener("DOMContentLoaded", convertPrescriptionUrlsToLinks);
       } else {
       convertPrescriptionUrlsToLinks();
       }
       window.addEventListener("load", convertPrescriptionUrlsToLinks);

       const cartObserver = new MutationObserver((mutations) => {
       let shouldScan = false;
       for (const mutation of mutations) {
       if (mutation.addedNodes.length > 0) {
        shouldScan = true;
        break;
       }
       }
       if (shouldScan) {
       convertPrescriptionUrlsToLinks();
       }
       });
       cartObserver.observe(document.body, { childList: true, subtree: true });

       // Periodic fallback scanner to catch delayed, asynchronous, or React re-renders
       setInterval(convertPrescriptionUrlsToLinks, 1500);
