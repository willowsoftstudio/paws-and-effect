    function deletePetProfile(id) {
      fetch(backendApiUrl + "/api/pets/profile/" + id, {
        method: "DELETE",
        headers: {
          "x-test-session-id": "paws-portal-session",
          "x-shop-domain": shopDomain
        }
      })
        .then(res => res.json())
        .then(data => {
          if (data.success) {
            customerPets = customerPets.filter(p => p.id !== id);
            renderPetsList();
            if (customerPets.length === 0) {
