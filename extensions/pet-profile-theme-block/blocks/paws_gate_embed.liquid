            "x-test-session-id": "paws-portal-session",
            "x-shop-domain": shopDomain
          },
          body: JSON.stringify(payload)
        })
          .then(res => {
            if (res.status === 403) {
              return res.json().then(err => {
                alert("🔒 Limit: " + err.message);
                throw new Error(err.message);
              });
            }
            return res.json();
          })
          .then(data => {
            if (data.success) {
              alert("🐾 Pet Profile saved successfully!");
              
              // Optimistically update customerPets array in current session memory!
              const newPet = data.profile;
              const index = customerPets.findIndex(p => p.id === newPet.id);
              if (index !== -1) customerPets[index] = newPet;
              else customerPets.push(newPet);
              
              renderPetsList();

              // If this profile was registered during an intercepted "Add to Cart" flow,
              // we can now immediately and seamlessly proceed with their original "Add to Cart"!
              const hasUploadedPrescription = newPet.prescriptionUrl && newPet.prescriptionUrl.trim() !== "";
              
              if (hasUploadedPrescription && (trappedSubmitEvent || trappedFetchArgs)) {
                console.log("⚕️ [Paws UI] Resuming intercepted Add to Cart with newly registered pet:", newPet.name);
                
                if (trappedSubmitEvent) {
                  const targetForm = trappedSubmitEvent.target;
                  injectPropertiesToForm(targetForm, newPet);
                  const currentTrap = trappedSubmitEvent;
                  trappedSubmitEvent = null;
                  targetForm.submit();
                } else if (trappedFetchArgs) {
                 // Re-evaluate fetch with newly registered pet
                 const options = trappedFetchArgs[1] || {};
                 if (options.body) {
                   try {
                     if (typeof options.body === "string") {
                       const bodyObj = JSON.parse(options.body);
                       if (bodyObj.items && Array.isArray(bodyObj.items)) {
                         bodyObj.items.forEach(item => {
                           if (!item.properties) item.properties = {};
                           item.properties["_Pet ID"] = newPet.id;
                           item.properties["_Pet Name"] = newPet.name;
                           item.properties["_Prescription S3 Key"] = newPet.prescriptionUrl;
                           const viewRedirectUrl = backendApiUrl + "/api/vets/view-prescription?key=" + encodeURIComponent(newPet.prescriptionUrl);
                           item.properties["Prescription"] = "✓ Uploaded (Pet: " + newPet.name + ")";
                           item.properties["Prescription Link"] = viewRedirectUrl;
                         });
                         options.body = JSON.stringify(bodyObj);
                       } else {
                         if (!bodyObj.properties) bodyObj.properties = {};
                         bodyObj.properties["_Pet ID"] = newPet.id;
                         bodyObj.properties["_Pet Name"] = newPet.name;
                         bodyObj.properties["_Prescription S3 Key"] = newPet.prescriptionUrl;
                         const viewRedirectUrl = backendApiUrl + "/api/vets/view-prescription?key=" + encodeURIComponent(newPet.prescriptionUrl);
                         bodyObj.properties["Prescription"] = "✓ Uploaded (Pet: " + newPet.name + ")";
                         bodyObj.properties["Prescription Link"] = viewRedirectUrl;
                         options.body = JSON.stringify(bodyObj);
                       }
                     } else if (options.body instanceof FormData) {
                       options.body.set("properties[_Pet ID]", newPet.id);
                       options.body.set("properties[_Pet Name]", newPet.name);
                       options.body.set("properties[_Prescription S3 Key]", newPet.prescriptionUrl);
                       const viewRedirectUrl = backendApiUrl + "/api/vets/view-prescription?key=" + encodeURIComponent(newPet.prescriptionUrl);
                       options.body.set("properties[Prescription]", "✓ Uploaded (Pet: " + newPet.name + ")");
                       options.body.set("properties[Prescription Link]", viewRedirectUrl);
                     }
                    } catch (e) {}
                  }
                  originalFetch.apply(window, trappedFetchArgs).then(trappedFetchResolve).catch(trappedFetchReject);
                  trappedFetchArgs = null;
                }
                
                if (modal) modal.style.display = "none";
                document.body.style.overflow = "auto";
              } else {
                // Return to main registered list view
                formView.style.display = "none";
