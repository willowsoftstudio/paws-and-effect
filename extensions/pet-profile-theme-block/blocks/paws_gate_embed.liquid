      });
    }

    if (guestLoginBtn) {
      guestLoginBtn.addEventListener("click", () => {
        window.location.href = "/account/login";
      });
    }

    // Choose Pet Form Cancel Button
    if (chooseCancelBtn) {
      chooseCancelBtn.addEventListener("click", () => {
        modal.style.display = "none";
        document.body.style.overflow = "auto";
        if (trappedFetchReject) trappedFetchReject(new Error("Gating canceled"));
      });
    }

    // Choose Pet Register New Pet Button
    if (chooseRegisterNewBtn) {
      chooseRegisterNewBtn.addEventListener("click", () => {
        editingPetId = null;
        uploadedPrescriptionKey = "";
        formTitle.innerText = "⚕️ Register Pet & Upload Prescription";
        formDescription.innerHTML = "<strong style='color: #b00;'>🔒 Gated Product:</strong> To purchase \"" + (activeProductTitle || "this product") + "\", please register your new pet and upload their vet prescription:";
        form.reset();
        uploadProgress.style.display = "none";
        fileInput.value = "";
        
        choosePetView.style.display = "none";
        listView.style.display = "none";
        formView.style.display = "block";
      });
    }

    loadCustomerPets();

    // Form Submit (Saves to Postgres database via Node Express backend API)
    if (form) {
      form.addEventListener("submit", (ev) => {
        ev.preventDefault();

        const rawAge = document.getElementById("paws-pet-age").value.replace(/[^0-9]/g, "");
        const rawWeight = document.getElementById("paws-pet-weight").value.replace(/[^0-9.]/g, "").replace(/(\..*?)\..*/g, "$1");

        const payload = {
          customerId,
          name: document.getElementById("paws-pet-name").value,
          petType: document.getElementById("paws-pet-type").value,
          breed: document.getElementById("paws-pet-breed").value,
          age: rawAge,
          weight: rawWeight,
          activityLevel: document.getElementById("paws-pet-activity").value,
          allergies: document.getElementById("paws-pet-allergies").value.split(",").map(s => s.trim()).filter(s => s !== ""),
